# Better Auth (stateless JWE cookie mode) + GitHub OAuth for the /studio Freewrite writing studio
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set to your site origin in local dev and Production (leave unset on Vercel Preview deployments)
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps)
# Authorization callback URLs (create one app for dev and one for prod):
#   http://localhost:3000/api/auth/callback/github
#   https://www.alexanderzwerner.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated list of GitHub account email addresses allowed to access /studio (fails closed if empty)
ADMIN_ALLOWED_EMAILS=

# Private Vercel Blob credentials (automatically added by Vercel when you connect a Blob store).
# Supports either BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID (with Vercel OIDC).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Local blob storage (used automatically when no Vercel Blob credentials are configured)
# Set USE_LOCAL_BLOB=true to force local disk storage even if Blob env vars are set.
USE_LOCAL_BLOB=false
# Optional custom path for local posts JSON (defaults to lib/posts.json)
LOCAL_BLOB_PATH=

# PostHog Analytics Configuration
# Get your PostHog project token from: https://app.posthog.com/project/settings
# PostHog is disabled on localhost / local development by default; set NEXT_PUBLIC_POSTHOG_ENABLE_LOCAL=true to send events locally.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLE_LOCAL=false
